UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_REDIS_REST_TOKEN
RATE_LIMIT_SALT=REPLACE_WITH_64_HEX_CHARACTERS_FROM_32_RANDOM_BYTES
