# ---- Agent Arbiter config. Copy to .env and fill in. NEVER commit .env ----

# Scoring LLM (optional in Week 1: falls back to a deterministic heuristic estimator)
# Provider: "auto" (Groq if a key is set, else heuristic) | "groq" | "heuristic"
ARBITER_LLM_PROVIDER=auto
ARBITER_GROQ_API_KEY=
# Current recommended Groq model; change only if your account does not expose it.
ARBITER_GROQ_MODEL=openai/gpt-oss-120b
# Tried once only when the primary returns a model-specific 404.
ARBITER_GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b

# OpenTask. The public discovery endpoint needs no auth (Week 1 is read-only).
# An agent API token is only needed for authenticated /api/agent/* routes (Week 2+).
ARBITER_OPENTASK_BASE_URL=https://opentask.ai
ARBITER_OPENTASK_API_TOKEN=

# execution.market: read-only discovery, no auth required
ARBITER_EXECUTION_MARKET_BASE_URL=https://api.execution.market

# Persistence
ARBITER_DB_PATH=data/arbiter.db
ARBITER_CHECKPOINT_DB_PATH=data/arbiter-checkpoints.db
# Physically separate from lifecycle tasks, outcomes, calibration, ledger, and P&L.
ARBITER_EVALUATION_DB_PATH=data/evaluations.db
# Versioned Agent Profile, Work Policy, decisions, candidates, and immutable packages.
ARBITER_CONTROL_PLANE_DB_PATH=data/control-plane.db
# Append-only local worker artifacts; never marketplace outcomes.
ARBITER_WORKER_ARTIFACT_DIR=data/worker-artifacts/v1

# Scoring / skip-filter thresholds
ARBITER_MIN_PAYOUT_USD=1.0
ARBITER_MAX_EFFORT_HOURS=0.25
ARBITER_COST_SAFETY_MARGIN=3.0
ARBITER_DAILY_BUDGET_USD=5.0

# Risk controls / circuit breaker
ARBITER_MAX_LOSS_PER_DAY_USD=5.0
ARBITER_MAX_COST_PER_TASK_USD=1.0
ARBITER_MAX_TASKS_PER_DAY=20
# Human approval at the claim gate. Keep true through weeks 1-3.
ARBITER_REQUIRE_APPROVAL=true

# Logging
ARBITER_LOG_LEVEL=INFO
ARBITER_LOG_JSON=false

# Legacy lifecycle safety flags. Wallet functionality remains absent and disabled.
ARBITER_ENABLE_WALLET=false
ARBITER_NETWORK=base-sepolia
