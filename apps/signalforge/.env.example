# Server-only model access. Never prefix this credential NEXT_PUBLIC_.
# Without a key, local development uses deterministic objective decomposition;
# the separately authorized public-source synthesis route is unavailable.
GROQ_API_KEY=
# No marketplace or discovered-service execution. Control the provider's quota.

# Optional shared public-metadata cache and distributed rate limiter.
# Set all three together in Vercel; placeholders intentionally blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Alternatively use the pair supplied by a Vercel KV / Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# auto uses configured Redis; otherwise non-durable per-instance demo memory.
# durable requires credentials; memory never overrides existing credentials.
# A configured store also requires RATE_LIMIT_SALT (at least 32 random characters).
CACHE_MODE=auto
# Optional explicit trusted namespace for non-Vercel hosting only.
# Vercel supplies VERCEL_ENV automatically. If both exist they must match.
# Allowed: production, preview, development, test.
SIGNALFORGE_ENV=development
# live: fixed public catalog GETs plus Agent Bounties conditional read-only feed.
# offline: no source requests. Does NOT enable fixtures.
DISCOVERY_MODE=live
# Explicit local/test opt-in only. Ignored when VERCEL_ENV=production.
ENABLE_DEMO_DATA=false
# Hosted APIs fail closed without shared Redis and the caller-key salt.

# Optional Supabase Auth and private saved-analysis history. These are public
# project identifiers, never service-role credentials. With them unset, every
# guest product workflow remains available and account persistence stays off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
