# Optional server-only objective decomposition. Never prefix secrets NEXT_PUBLIC_.
# Without a key or after a provider failure: Local demo decomposition.
GROQ_API_KEY=
# No tools or task-service execution. Operator controls the provider's quota.

# Optional shared public-metadata cache and distributed rate limiter.
# Set all three together in Vercel; placeholders intentionally blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# auto uses configured Redis; otherwise non-durable per-instance demo memory.
# redis requires credentials; memory never overrides existing Redis credentials.
CACHE_MODE=auto
# live: only two fixed public catalog GETs. offline: no catalog network calls.
DISCOVERY_MODE=live
